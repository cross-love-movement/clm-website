# ── Public site ──────────────────────────────────────────────
# Used for canonical URLs and social previews.
NUXT_PUBLIC_SITE_URL=https://www.clmnative.com

# ── Mail delivery (Resend) ───────────────────────────────────
# Without a key, form submissions are printed to the server console
# so local development works with no account.
NUXT_RESEND_API_KEY=
NUXT_MAIL_FROM="Cross-Love Movement <info@clmnative.com>"
NUXT_MAIL_TO=info@clmnative.com

# ── Nuxt Studio (content editing) ────────────────────────────
# Create an OAuth app at https://github.com/settings/developers
#   Homepage URL:              https://www.clmnative.com
#   Authorization callback:    https://www.clmnative.com/__nuxt_studio/auth/github
#                              http://localhost:3000/__nuxt_studio/auth/github (local)
# Leave these empty for local development: Studio works without OAuth in dev mode
# and writes directly to the files in `content/`.
NUXT_STUDIO_AUTH_GITHUB_CLIENT_ID=
NUXT_STUDIO_AUTH_GITHUB_CLIENT_SECRET=
# Comma-separated GitHub account emails allowed to edit. Without this,
# every user who can authorise the OAuth app gets write access.
NUXT_STUDIO_AUTH_GITHUB_MODERATORS=
