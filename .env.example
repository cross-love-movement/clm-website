# ── Public site ──────────────────────────────────────────────
# Used for canonical URLs and social previews.
NUXT_PUBLIC_SITE_URL=https://www.clmnative.ovahol.com

# ── Database (Postgres) ──────────────────────────────────────
# Provided by Coolify as a service. Use the internal connection string.
DATABASE_URL=
# Only true for a public/managed database that requires TLS.
DATABASE_SSL=false
DATABASE_POOL_SIZE=10
# Set false if migrations are applied by a separate deploy step.
DB_MIGRATE_ON_START=true
# Where the migration SQL lives at runtime. Defaults to
# server/database/migrations; the Docker image sets /app/migrations.
MIGRATIONS_DIR=
# Seeds the first superadmin on boot. Remove after the first deploy, or leave
# set — seeding is idempotent and never overwrites an existing account.
SEED_SUPERADMIN_EMAIL=
SEED_SUPERADMIN_NAME=

# ── Sessions (nuxt-auth-utils) ───────────────────────────────
# Signs the session cookie. 32+ characters, and must stay secret.
# Generate with: openssl rand -base64 32
NUXT_SESSION_PASSWORD=

# ── Mail delivery (Resend) ───────────────────────────────────
# Without a key, form submissions are printed to the server console
# so local development works with no account.
NUXT_RESEND_API_KEY=
NUXT_MAIL_FROM="Cross-Love Movement <info@clmnative.com>"
NUXT_MAIL_TO=info@clmnative.com

# ── Event registrations ──────────────────────────────────────
# SQLite file for event bookings. In production this MUST point at a
# persistent volume, or registrations are lost on every redeploy.
# Local default: .data/events.sqlite
NUXT_EVENTS_DB_PATH=/app/data/events.sqlite

# Protects /api/events/registrations (list, CSV export, cancel).
# Generate with: openssl rand -hex 32
# Leave empty to disable the endpoint entirely.
NUXT_REGISTRATIONS_TOKEN=

# ── Nuxt Studio (content editing) ────────────────────────────
# Create an OAuth app at https://github.com/settings/developers
#   Homepage URL:              https://www.clmnative.com
#   Authorization callback:    https://www.clmnative.com/__nuxt_studio/auth/github
#                              http://localhost:3000/__nuxt_studio/auth/github (local)
# Leave these empty for local development: Studio works without OAuth in dev mode
# and writes directly to the files in `content/`.
NUXT_STUDIO_AUTH_GITHUB_CLIENT_ID=
NUXT_STUDIO_AUTH_GITHUB_CLIENT_SECRET=
# Comma-separated GitHub account emails allowed to edit. Without this,
# every user who can authorise the OAuth app gets write access.
NUXT_STUDIO_AUTH_GITHUB_MODERATORS=oaedward83@gmail.com
